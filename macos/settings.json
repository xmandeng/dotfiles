{
  "window.title": "${separator}${rootName}${separator}${dirty}${activeEditorMedium}",
  "workbench.editor.highlightModifiedTabs": true,
  "editor.suggest.showStatusBar": true,
  "editor.inlineSuggest.enabled": true,
  "editor.formatOnPaste": true,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', 'FiraCode Nerd Font', monospace",
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "all",
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },
  "editor.renderControlCharacters": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "files.eol": "\n",
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.simpleDialog.enable": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "explorer.confirmDragAndDrop": false,
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestArgs": ["unit_tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.venvPath": "${workspaceFolder}/.venv",
  "python.venvFolders": ["${workspaceFolder}/.venv"],
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "standard",
  "python.experiments.enabled": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "jupyter.askForKernelRestart": false,
  "jupyter.useDefaultConfigForJupyter": true,
  "notebook.formatOnSave.enabled": true,
  "terminal.integrated.fontFamily": "Menlo, Monaco, 'Courier New', 'FiraCode Nerd Font', monospace",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "bash",
      "args": [
        "-ilc",
        "[ -f .env ] && set -a && source .env && set +a; exec bash"
      ],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh",
      "args": [
        "-ilc",
        "[ -f .env ] && set -a && source .env && set +a; exec zsh"
      ],
      "env": {
        "workspaceFolder": "${workspaceFolder}"
      }
    }
  },
  "terminal.integrated.env.osx": {
    "VIRTUAL_ENV_DISABLE_PROMPT": "1"
  },
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.mergeEditor": true,
  "git.openRepositoryInParentFolders": "never",
  // "http.proxyStrictSSL": false,
  // "http.systemCertificates": false,
  "security.workspace.trust.untrustedFiles": "open",
  "aws.telemetry": false,
  "interactiveWindow.promptToSaveOnClose": true,
  "isort.importStrategy": "fromEnvironment",
  "flake8.importStrategy": "fromEnvironment",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.editorAssociations": {
    "{git,gitlens,conflictResolution,vscode-local-history}:/**/*.tc.json": "default",
    "*.icns": "default"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "errorLens.enabled": false,
  "zenMode.hideLineNumbers": false,
  "redhat.telemetry.enabled": false,
  "update.mode": "none",
  "markdown-preview-enhanced.liveUpdate": false,
  "http.proxyStrictSSL": false,
  "http.systemCertificates": true
}
