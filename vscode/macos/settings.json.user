{
  "window.title": "${separator}${rootName}${separator}${dirty}${activeEditorMedium}",
  "workbench.editor.highlightModifiedTabs": true,
  "editor.suggest.showStatusBar": true,
  "editor.inlineSuggest.enabled": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "files.defaultLanguage": "python",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.eol": "\n",
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.simpleDialog.enable": true,
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,
  "explorer.confirmDragAndDrop": false,
  "zenMode.hideLineNumbers": false,
  "remote.SSH.remotePlatform": {
    "Vader": "linux",
    "Baylan": "linux",
    "Kreia": "windows"
  },
  "redhat.telemetry.enabled": false,
  "security.workspace.trust.untrustedFiles": "open",
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.mergeEditor": true,
  "[python]": {
    "editor.formatOnType": true
  },
  "jupyter.askForKernelRestart": false,
  "jupyter.useDefaultConfigForJupyter": true,
  "notebook.formatOnSave.enabled": true,
  "interactiveWindow.promptToSaveOnClose": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.defaultProfile.linux": "mybash",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.splitCwd": "workspaceRoot",
  "terminal.integrated.profiles.linux": {
    "mybash": {
      "path": "/bin/bash"
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.openRepositoryInParentFolders": "never",
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', 'FiraCode Nerd Font', monospace",
  "terminal.integrated.fontFamily": "Menlo, Monaco, 'Courier New', 'FiraCode Nerd Font', monospace",
  "workbench.editorAssociations": {
    "{git,gitlens,conflictResolution,vscode-local-history}:/**/*.tc.json": "default",
    "*.icns": "default"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "remote.SSH.showLoginTerminal": true,
  "errorLens.enabled": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "pylint.enabled": false,
  "terminal.integrated.sendKeybindingsToShell": true,
  "notebook.diff.ignoreOutputs": true,
  "notebook.diff.ignoreMetadata": true,
  "githubPullRequests.pullBranch": "never",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "python": false
  },
  "codesnap.transparentBackground": true,
  "codesnap.boxShadow": "rgba(0, 0, 0, 0) 0px 0px 0px"
}
